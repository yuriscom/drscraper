<html>
<head>
    <% if (user) { %>
        <script>
          var command = "<%= command %>";
          var wshost = "<%= wshost %>";
          var ws = new WebSocket('ws://' + wshost + ':9090');
          ws.onopen = function (event) {
            ws.send(command);
          };
          ws.onmessage = function (event) {
            var data = JSON.parse(event.data); // Parse the JSON
            if (data.error) {
              // Handle error messages
              document.getElementById('data').innerHTML += `Done.<br/> <p style="color:red;">${data.error}</p>`;
            } else if (data.filePath) {
              // Handle file path
              document.getElementById('data').innerHTML += " Done.<br/>Click the link to <a href=\"/getfile?path=" + window.btoa(data.filePath) + "\">Get Excel file</a>";
            } else {
              document.getElementById('data').innerHTML += "Something went wrong.";
            }
          };
        </script>
</head>
<body>
<%- include('form.ejs'); -%>
<div id='data'>Scraping, please wait...</div>
<% } else { %>
    <%- include('form.ejs'); -%>
<% } %>
</body>
</html>
