<html>
<head>
    <link rel="stylesheet" href="/stylesheets/w3.css">
    <link rel="stylesheet" href="/stylesheets/style.css">
    <style>
        tr > td {
            padding-bottom: 1em;
        }

        select {
            overflow: hidden;
            width: 240px;
        }

        input {
            width: 240px;
        }

        .btn {
            padding-left: 170px;
            padding-top: 20px;
        }

        .radio-group {
            display: flex;
            align-items: center;
            gap: 0px;
        }

        .radio-group input[type="radio"] {
            width: 30px;
        }
    </style>
</head>
<body>
<%- include('navbar.ejs') %>
<% if (user) { %>
    <form action="/scrape" method="get" enctype="multipart/form-data">
        <fieldset>
            <table>
                <tr>
                    <td><label for="doctor-type">Select Doctor Type:</label></td>
                    <td>
                        <div class="radio-group">
                            <input type="radio" id="familyDoctor" name="doctorType" value="family" onclick="toggleSpecialization(false)" checked />
                            <label for="familyDoctor">Family Doctor</label>
                            <input type="radio" id="specialization" name="doctorType" value="spec" onclick="toggleSpecialization(true)" />
                            <label for="specialization">Specialization</label>
                        </div>
                    </td>
                </tr>
                <tr id="specialization-row" style="display: none;">
                    <td>
                        <label for="spec">Specialization:</label>
                    </td>
                    <td>
                        <select name="spec" id="spec">
                            <%- include('partials/specialties.ejs') %>
                        </select>
                    </td>
                </tr>
                <tr>
                    <td><label for="city">Select a City or Town:</label></td>
                    <td>
                        <select name="city" id="city">
                            <%- include('partials/cities.ejs') %>
                        </select>
                    </td>
                </tr>
                <tr><td colspan="2">OR</td></tr>
                <tr>
                    <td>
                        <label for="postal">Enter the first three characters of a postal code:</label>
                    </td>
                    <td>
                        <input name="postal" type="text" maxlength="3" id="postal">
                    </td>
                </tr>
                <tr>
                    <td colspan="2" class="btn"><input class="button" type="submit" value="Go..."/></td>
                </tr>
            </table>
        </fieldset>
    </form>
    <script>
      // Toggles the display of the specialization dropdown based on the radio button selection
      function toggleSpecialization(show) {
        const specializationRow = document.getElementById('specialization-row');
        if (show) {
          specializationRow.style.display = '';
        } else {
          specializationRow.style.display = 'none';
        }
      }

      document.getElementById('postal').onkeypress = function(event) {
        var regex = new RegExp("^[a-zA-Z0-9]+$");
        var key = String.fromCharCode(event.keyCode);
        if (!regex.test(key)) {
          event.preventDefault();
          return false;
        }
      }
    </script>
<% } else { %>
    <h4>You are not logged in! Please <a href="/login">Log In</a> to continue</h4>
<% } %>
</body>
</html>
